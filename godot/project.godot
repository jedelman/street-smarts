config_version=5

[application]

config/name="Street Smarts - Christopher Alexander Provocation Engine"
config/description="Rust + Godot 4 spatial engine for Alexander pattern language, Salingaros geometry, and activist provocation."
run/main_scene="res://scenes/MainMenu.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")

[autoload]

GameState="*res://scripts/game_state.gd"

[input_devices]

# Off, deliberately: on by Godot's own default, every touch ALSO
# synthesizes a mouse-button/motion event. orbit_camera.gd's real mouse
# handling exists for desktop testing, but with this on, a finger on
# touch_joystick.gd's virtual stick generates a synthetic mouse drag too --
# which orbit_camera.gd's _unhandled_input() sees and orbits/looks from,
# since the joystick only claims the real InputEventScreenTouch/Drag
# events, not their synthesized mouse counterparts. Confirmed against
# Godot's own source (main.cpp, GLOBAL_DEF_BASIC default = true) before
# touching this, not guessed.
pointing/emulate_mouse_from_touch=false

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/stretch/mode="canvas_items"
window/handheld/orientation=1

[rendering]

renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="mobile"
anti_aliasing/quality/msaa_3d=2
textures/vram_compression/import_etc2_astc=true
